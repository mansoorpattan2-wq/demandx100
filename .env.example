# DemandX 2.0 — Enterprise Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` and fill in your Supabase & deployment parameters.
# If database credentials are left empty, DemandX operates seamlessly via its
# persistent Local Engine (sqlite:///demandx.db).

# ==============================================================================
# 1. SUPABASE POSTGRESQL DATABASE (Backend Persistence Layer)
# ==============================================================================
# Supabase PostgreSQL connection string.
# Option A (Supabase Connection Pooler - Recommended for Render/Serverless):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?sslmode=require
#
# Option B (Supabase Direct Session Connection):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
#
# Or alias:
# SUPABASE_DB_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
SUPABASE_DB_URL=

# Supabase Service Role Secret (Backend admin tasks only - NEVER EXPOSE TO FRONTEND)
SUPABASE_SERVICE_ROLE_KEY=

# ==============================================================================
# 2. SUPABASE API & REALTIME (Frontend Client Integration)
# ==============================================================================
# Public project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=
# Public Anon Key (safe for browser client)
VITE_SUPABASE_ANON_KEY=

# ==============================================================================
# 3. BACKEND FASTAPI CONFIGURATION (Render / Docker / Local)
# ==============================================================================
PORT=8001
HOST=0.0.0.0
ENVIRONMENT=development

# Backend REST Base URL consumed by Vite frontend (Defaults automatically to https://demandx100.onrender.com in production)
VITE_API_BASE_URL=https://demandx100.onrender.com

# Public Razorpay Key ID (Client-side checkout modal)
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Pluggable Large Language Model (LLM) API Keys (Optional)
# If no key is configured, DemandX JARVIS operates via its Autonomous Local Engine.
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
